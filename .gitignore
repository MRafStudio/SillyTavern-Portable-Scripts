# ============================================================
#               SillyTavern Portable — .gitignore
# ============================================================

# --- Компоненты (устанавливаются скриптами) ---
SillyTavern/
python-*/
node-dist/
npm_cache/
huggingface_cache/
marian/
tts-cpu/
AppData/

# --- Данные (создаются при запуске) ---
/data/
output/
logs/
*.log

# --- Пользовательские настройки ---
scripts/settings.ini
config.yaml

# --- Генерируемые/загружаемые файлы ---
*.wav
*.mp3
*.safetensors
*.bin
*.gguf
*.ckpt
*.pth

# --- Windows ---
*.exe
*.dll
*.zip
*.7z
!scripts/bin/nssm.exe

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- IDE ---
.vs/
.vscode/
.idea/
*.sln
*.user
